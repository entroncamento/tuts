APP_NAME=tuts-core
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=tuts_database
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=r2

# Cloudflare R2 Storage (reused for official subject materials)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=tuts-materials-dev
CLOUDFLARE_R2_ENDPOINT=

# RAG Ingestion Service configuration
RAG_SERVICE_BASE_URL=
RAG_SERVICE_INTERNAL_TOKEN=
