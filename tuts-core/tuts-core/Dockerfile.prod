FROM node:20-alpine AS node_builder

WORKDIR /app

COPY package*.json ./

# Instalamos de forma limpa para ler o override do Rollup
RUN npm install

COPY . .
RUN npm run build


# ─────────────────────────────────────────────
# 2. PHP / LARAVEL RUNTIME (FRANKENPHP)
# ─────────────────────────────────────────────
FROM dunglas/frankenphp:php8.2

# system deps (SEM NODE)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    supervisor \
    && docker-php-ext-install pdo_pgsql zip pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

# composer fixo e seguro
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# app code
COPY . .

# PHP runtime upload limits for Render/prod images.
COPY docker/php/conf.d/uploads.ini /usr/local/etc/php/conf.d/uploads.ini

# PHP deps
RUN composer config --global source-fallback true

RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --prefer-dist

# frontend já compilado
COPY --from=node_builder /app/public/build /app/public/build

# Laravel safety
# Build-time Laravel config cache disabled: runtime env vars must come from the deploy platform.

# APP_KEY safe
# Build-time APP_KEY generation disabled: APP_KEY must be provided as a stable runtime secret.

# permissões
RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R a+rwX storage bootstrap/cache

ENV OCTANE_SERVER=frankenphp

EXPOSE 10000

CMD ["sh", "-lc", "set -e; echo '[TUTS][Startup] DB fingerprint before startup'; php artisan tuts:db-fingerprint --label=before-startup || true; echo '[TUTS][Startup] Clearing Laravel caches'; php artisan optimize:clear; echo '[TUTS][Startup] Running DB startup guard'; php artisan tuts:db-startup-guard; echo '[TUTS][Startup] Starting Laravel server on PORT='${PORT:-10000}; php -v; ls -ld storage storage/logs bootstrap/cache; exec php artisan serve --host=0.0.0.0 --port=${PORT:-10000}"]
