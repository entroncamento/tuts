# ─────────────────────────────────────────────
# 1. FRONTEND BUILD STAGE (NODE ISOLADO)
# ─────────────────────────────────────────────
FROM node:20-alpine AS node_builder

WORKDIR /app

COPY package*.json ./

# Instalamos de forma limpa para ler o override do Rollup
RUN npm install

COPY . .
RUN npm run build


# ─────────────────────────────────────────────
# 2. PHP / LARAVEL RUNTIME (FRANKENPHP)
# ─────────────────────────────────────────────
FROM dunglas/frankenphp:php8.2

# system deps (SEM NODE)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    supervisor \
    && docker-php-ext-install pdo_pgsql zip pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

# composer fixo e seguro
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# app code
COPY . .

# PHP deps
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --prefer-dist

# frontend já compilado
COPY --from=node_builder /app/public/build /app/public/build

# Laravel safety
RUN if [ ! -f .env ]; then cp .env.example .env; fi && \
    php artisan config:cache || true && \
    php artisan route:cache || true && \
    php artisan view:cache || true

# APP_KEY safe
RUN if ! grep -q "APP_KEY=base64:" .env 2>/dev/null; then \
    php artisan key:generate || true ; \
    fi

# permissões
RUN chown -R www-data:www-data storage bootstrap/cache

ENV OCTANE_SERVER=frankenphp

EXPOSE 80
EXPOSE 2019

CMD ["php", "artisan", "octane:start", "--server=frankenphp", "--host=0.0.0.0", "--port=80", "--admin-port=2019"]