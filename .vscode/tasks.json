{
  "version": "2.0.0",
  "presentation": {
    "panel": "shared",
    "showReuseMessage": false,
    "clear": true,
    "echo": false,
    "focus": false
  },
  "tasks": [
    {
      "label": "TUTS: Arrancar Tudo",
      "dependsOn": [
        "0. REDIS (Redis Stack)",
        "1. BACKEND (Laravel/Sail)",
        "2. FRONTEND (Vue/Vite)",
        "3. RAG (Python/FastAPI)",
        "4. GIT"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "icon": {
        "id": "play-circle",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "0. REDIS (Redis Stack)",
      "type": "shell",
      "command": "if docker inspect redis-stack >/dev/null 2>&1; then docker start redis-stack; else echo 'Container redis-stack nao existe. Cria-o primeiro, por exemplo: docker run -d --name redis-stack -p 6379:6379 redis/redis-stack-server:latest'; fi",
      "presentation": {
        "reveal": "always",
        "close": false,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "1. BACKEND (Laravel/Sail)",
      "type": "shell",
      "command": "./vendor/bin/sail up -d",
      "options": {
        "cwd": "${workspaceFolder}/tuts-core"
      },
      "presentation": {
        "group": "tuts-services",
        "panel": "new"
      },
      "icon": {
        "id": "server-environment",
        "color": "terminal.ansiRed"
      },
      "problemMatcher": []
    },
    {
      "label": "2. FRONTEND (Vue/Vite)",
      "type": "shell",
      "command": "set -e; echo 'A aguardar pelo Laravel/Sail...'; until container=$(./vendor/bin/sail ps -q laravel.test 2>/dev/null) && [ -n \"$container\" ] && docker inspect -f '{{.State.Running}}' \"$container\" 2>/dev/null | grep -q true; do sleep 2; done; echo 'A limpar Vite/npm/node antigo dentro do container...'; docker exec \"$container\" sh -lc 'pkill -9 -f [v]ite 2>/dev/null || true; pkill -9 -f [n]pm 2>/dev/null || true; pkill -9 -f [n]ode 2>/dev/null || true'; rm -f public/hot; echo 'A iniciar Vue/Vite...'; ./vendor/bin/sail npm run dev -- --host 0.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}/tuts-core"
      },
      "isBackground": true,
      "presentation": {
        "group": "tuts-services",
        "panel": "new"
      },
      "icon": {
        "id": "browser",
        "color": "terminal.ansiCyan"
      },
      "problemMatcher": []
    },
    {
      "label": "3. RAG (Python/FastAPI)",
      "type": "shell",
      "command": "./venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001 --env-file .env --reload --reload-dir . --reload-exclude venv --reload-exclude faiss_db --reload-exclude __pycache__ --reload-exclude pdfs",
      "options": {
        "cwd": "${workspaceFolder}/tuts-rag-service"
      },
      "isBackground": true,
      "presentation": {
        "group": "tuts-services",
        "panel": "new"
      },
      "icon": {
        "id": "hubot",
        "color": "terminal.ansiYellow"
      },
      "problemMatcher": []
    },
    {
      "label": "4. GIT",
      "type": "shell",
      "command": "bash",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "tuts-workspace",
        "panel": "new"
      },
      "icon": {
        "id": "terminal-bash",
        "color": "terminal.ansiMagenta"
      },
      "problemMatcher": []
    }
  ]
}
